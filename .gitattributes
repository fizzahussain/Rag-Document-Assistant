# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific text file formats to use LF
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.sql text eol=lf

# Batch scripts on Windows must maintain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
*.tar.gz binary
