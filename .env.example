# Application
APP_ENV=development
AUTH_SECRET_KEY=change-me-in-production

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/rag_db

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# Retrieval and chunk context
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNK_CONTEXT_SUMMARY_ENABLED=true
CHUNK_CONTEXT_SUMMARY_MAX_CHARS=700
CHUNK_CONTEXT_LLM_STRIDE=12
CHAT_HISTORY_MESSAGES=4

# Selective local OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# LLM / Ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=3072
OLLAMA_NUM_PREDICT=280
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_ON_STARTUP=true

# Voice / speech-to-text
TRANSCRIPTION_PROVIDER=faster-whisper
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_BEAM_SIZE=5
TRANSCRIPTION_TIMEOUT_SECONDS=180
MAX_AUDIO_SIZE_MB=25
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,ogg,webm,flac
