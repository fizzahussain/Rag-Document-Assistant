# Environment Mode (development / staging / production)
APP_ENV=development

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:7860", "http://127.0.0.1:7860"]

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/rag_db

# Vector Database Configuration (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# File Ingestion & Storage Security
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx", "txt", "md", "csv", "html", "json"]

# Embedding Provider Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Provider Configuration
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
OPENAI_API_KEY=

# Structured Logging
LOG_LEVEL=INFO

AUTH_SECRET_KEY=replace-with-a-long-random-secret
RAG_ACCESS_TOKEN=
